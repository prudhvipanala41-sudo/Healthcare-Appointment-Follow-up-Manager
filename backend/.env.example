# ---- Core ----
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-another-random-string

# ---- Database ----
# SQLite by default (zero setup, free, file-based). For production-like use,
# swap to a free Postgres instance (Render/Neon/Supabase free tier) - just
# change this URI, SQLAlchemy models work unchanged.
DATABASE_URL=sqlite:///healthcare.db

# ---- LLM (Groq - free tier, no credit card required) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_free_groq_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# ---- Email (Gmail SMTP - free, uses an App Password, not your real password) ----
# Create one at https://myaccount.google.com/apppasswords (requires 2FA enabled)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_DEFAULT_SENDER=your_gmail_address@gmail.com

# ---- Google Calendar API (free quota, OAuth 2.0) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# See README "Google Calendar Setup" section for the full walkthrough.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth2callback

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173

# ---- Misc ----
SLOT_HOLD_SECONDS=120
